(export (version "E")
  (design
    (source "wearable_posture_sensor.kicad_sch")
    (date "2026-10-24")
    (tool "Eeschema 8.0")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "Wearable Posture Sensor Schematic")
        (company "Wearable Bio-Sensors Lab")
        (rev "1.0")
        (date "2026-10-24")
      )
    )
  )
  (components
    (comp (ref "U1")
      (value "ESP32-C3")
      (footprint "Module:Seeed_XIAO_ESP32C3")
      (libsource (lib "Wearable") (part "Seeed_XIAO_ESP32-C3") (description "Ultra-small RISC-V MCU with BLE 5.0, LiPo battery charging pads, 3.3V LDO"))
    )
    (comp (ref "BT1")
      (value "3.7V 350mAh")
      (footprint "Battery:BatteryHolder_Keystone_1058")
      (libsource (lib "Wearable") (part "LiPo_Battery") (description "Rechargeable Single Cell Lithium-Ion Polymer Battery (3.7V nominal, 4.2V peak)"))
    )
    (comp (ref "SW1")
      (value "Power Switch")
      (footprint "Button_Switch_SMD:SW_SPST_CK_JS102011SAQN")
      (libsource (lib "Wearable") (part "SPST_Slide_Switch") (description "Single Pole Single Throw Master Power Switch"))
    )
    (comp (ref "SW2")
      (value "6x6mm Tactile")
      (footprint "Button_Switch_SMD:SW_Push_SPST_NO_Alps_SKRK")
      (libsource (lib "Wearable") (part "Pushbutton") (description "Normally-open tactile momentary switch for posture tare / calibration"))
    )
    (comp (ref "R1")
      (value "220 Ω")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (libsource (lib "Wearable") (part "Resistor") (description "Current limiting resistor for posture warning indicator LED"))
    )
    (comp (ref "D1")
      (value "Amber 2.0V 20mA")
      (footprint "LED_SMD:LED_0805_2012Metric")
      (libsource (lib "Wearable") (part "Alert_LED") (description "Posture deviation / slouch warning visual indicator"))
    )
    (comp (ref "U2")
      (value "IMU lower (0x68)")
      (footprint "Module:GY-521_MPU6050")
      (libsource (lib "Wearable") (part "MPU-6050_(GY-521)") (description "Lower spine (lumbar reference) 6-DOF IMU accelerometer & gyroscope, AD0 pulled to GND -> I2C 0x68"))
    )
    (comp (ref "U3")
      (value "IMU upper (0x69)")
      (footprint "Module:GY-521_MPU6050")
      (libsource (lib "Wearable") (part "MPU-6050_(GY-521)") (description "Upper spine (thoracic sensor) 6-DOF IMU accelerometer & gyroscope, AD0 pulled to 3V3 -> I2C 0x69"))
    )
    (comp (ref "U4")
      (value "Haptic Driver (0x5A)")
      (footprint "Module:Adafruit_DRV2605L")
      (libsource (lib "Wearable") (part "DRV2605L_Breakout") (description "Precision haptic motor driver with ERM & LRA waveform ROM library. I2C 0x5A, EN tied to 3V3"))
    )
    (comp (ref "M1")
      (value "ERM 3.0V 75mA")
      (footprint "Motor:VibrationMotor_Coin_10mm")
      (libsource (lib "Wearable") (part "Coin_Vibration_Motor") (description "10mm pancake eccentric rotating mass (ERM) coin vibration motor for silent tactile alerts"))
    )
  )
  (nets
    (net (code "1") (name "BAT_SW")
      (node (ref "U1") (pin "BP+") (pinfunction "BAT+"))
      (node (ref "SW1") (pin "2") (pinfunction "2"))
    )
    (net (code "2") (name "GND")
      (node (ref "U1") (pin "BP-") (pinfunction "BAT-"))
      (node (ref "U1") (pin "12") (pinfunction "GND"))
      (node (ref "BT1") (pin "2") (pinfunction "-"))
      (node (ref "SW2") (pin "2") (pinfunction "2"))
      (node (ref "D1") (pin "2") (pinfunction "K"))
      (node (ref "U2") (pin "2") (pinfunction "GND"))
      (node (ref "U2") (pin "7") (pinfunction "AD0"))
      (node (ref "U3") (pin "2") (pinfunction "GND"))
      (node (ref "U4") (pin "2") (pinfunction "GND"))
    )
    (net (code "3") (name "3V3")
      (node (ref "U1") (pin "11") (pinfunction "3V3"))
      (node (ref "U2") (pin "1") (pinfunction "VCC"))
      (node (ref "U3") (pin "1") (pinfunction "VCC"))
      (node (ref "U3") (pin "7") (pinfunction "AD0"))
      (node (ref "U4") (pin "1") (pinfunction "VIN"))
      (node (ref "U4") (pin "6") (pinfunction "EN"))
    )
    (net (code "4") (name "BTN_CALIB")
      (node (ref "U1") (pin "2") (pinfunction "D1 (GPIO3)"))
      (node (ref "SW2") (pin "1") (pinfunction "1"))
    )
    (net (code "5") (name "LED_SIG")
      (node (ref "U1") (pin "3") (pinfunction "D2 (GPIO4)"))
      (node (ref "R1") (pin "1") (pinfunction "1"))
    )
    (net (code "6") (name "SDA")
      (node (ref "U1") (pin "5") (pinfunction "D4 (GPIO6/SDA)"))
      (node (ref "U2") (pin "4") (pinfunction "SDA"))
      (node (ref "U3") (pin "4") (pinfunction "SDA"))
      (node (ref "U4") (pin "4") (pinfunction "SDA"))
    )
    (net (code "7") (name "SCL")
      (node (ref "U1") (pin "6") (pinfunction "D5 (GPIO7/SCL)"))
      (node (ref "U2") (pin "3") (pinfunction "SCL"))
      (node (ref "U3") (pin "3") (pinfunction "SCL"))
      (node (ref "U4") (pin "3") (pinfunction "SCL"))
    )
    (net (code "8") (name "BAT_RAW")
      (node (ref "BT1") (pin "1") (pinfunction "+"))
      (node (ref "SW1") (pin "1") (pinfunction "1"))
    )
    (net (code "9") (name "LED_ANODE")
      (node (ref "R1") (pin "2") (pinfunction "2"))
      (node (ref "D1") (pin "1") (pinfunction "A"))
    )
    (net (code "10") (name "HAPTIC_OUT_P")
      (node (ref "U4") (pin "7") (pinfunction "OUT+"))
      (node (ref "M1") (pin "1") (pinfunction "+"))
    )
    (net (code "11") (name "HAPTIC_OUT_N")
      (node (ref "U4") (pin "8") (pinfunction "OUT-"))
      (node (ref "M1") (pin "2") (pinfunction "-"))
    )
  )
)